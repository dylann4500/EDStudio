 "subs": [
  [
   3.8,
   8.0,
   "February 12, 1809: in a one-room log cabin in Kentucky, Abraham Lincoln is born."
  ],
  [
   8.45,
   11.15,
   "At seven, his family moves into the Indiana woods,"
  ],
  [
   11.4,
   15.0,
   "and his father hands him an axe he'll swing for fifteen years."
  ],
  [
   15.45,
   18.45,
   "Two years later, his mother Nancy dies. Abe is nine."
  ],
  [
   19.25,
   22.85,
   "He gets less than a year of school in his whole life,"
  ],
  [
   23.1,
   26.7,
   "so he teaches himself, reading every book he can borrow by firelight."
  ],
  [
   27.15,
   30.75,
   "At nineteen, he rafts over a thousand miles downriver to New Orleans."
  ],
  [
   31.2,
   35.4,
   "There he sees people sold at a slave auction, and he never forgets it."
  ],
  [
   36.8,
   39.8,
   "Back in Illinois, he clerks at a small-town general store."
  ],
  [
   40.3,
   44.8,
   "When he overcharges a woman a few cents, he walks miles to pay her back."
  ],
  [
   45.05,
   46.85,
   "People start calling him “Honest Abe.”"
  ],
  [
   47.3,
   51.2,
   "Reading borrowed law books late at night, he becomes a lawyer at 27."
  ],
  [
   51.65,
   55.25,
   "In 1858, he faces Stephen Douglas in seven famous debates over slavery."
  ],
  [
   55.7,
   59.3,
   "He loses the race, but now the whole country knows his name."
  ],
  [
   59.75,
   63.05,
   "In 1860, he's elected the 16th President of the United States."
  ],
  [
   63.5,
   68.0,
   "An eleven-year-old girl writes that he'd look better with a beard, so he grows one."
  ],
  [
   68.75,
   72.35,
   "Before he even takes office, the South breaks away, and war begins."
  ],
  [
   73.0,
   76.9,
   "On New Year's Day, 1863, he sits down to sign the Emancipation Proclamation."
  ],
  [
   77.35,
   81.25,
   "His hand shakes from hours of handshakes, so he waits until it's steady."
  ],
  [
   81.9,
   84.6,
   "At Gettysburg, the main speaker talks for two hours."
  ],
  [
   85.5,
   88.8,
   "Lincoln speaks for two minutes. 272 words people still quote today."
  ],
  [
   89.35,
   92.65,
   "April 9, 1865: after four brutal years, the war is over."
  ],
  [
   93.1,
   97.3,
   "Five days later, Abe and Mary go to see a comedy at Ford's Theatre."
  ],
  [
   97.75,
   102.25,
   "At 10:15 PM, an actor named John Wilkes Booth slips into their box and fires."
  ],
  [
   103.5,
   105.9,
   "Lincoln dies the next morning. He is 56."
  ],
  [
   106.15,
   107.95,
   "“Now he belongs to the ages.”"
  ],
  [
   108.7,
   112.0,
   "The boy from a log cabin held a breaking country together,"
  ],
  [
   112.25,
   114.35,
   "and helped set four million people free."
  ]
 ],
