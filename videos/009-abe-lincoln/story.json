 "subs": [
  [
   3.7,
   6.7,
   "February 12, 1809. A log cabin in Kentucky."
  ],
  [
   7.0,
   9.8,
   "At 7, his family moves to the Indiana woods."
  ],
  [
   10.0,
   13.0,
   "He's handed an axe. He'll swing it for 15 years."
  ],
  [
   13.08,
   15.7,
   "At 9, he loses his mother, Nancy."
  ],
  [
   16.0,
   19.4,
   "Less than one year of school. So he reads by firelight."
  ],
  [
   19.7,
   22.7,
   "At 19, he rafts over 1,000 miles to New Orleans."
  ],
  [
   22.78,
   25.78,
   "He sees people sold at auction. He never forgets it."
  ],
  [
   25.86,
   28.4,
   "22. A store clerk in New Salem, Illinois."
  ],
  [
   28.7,
   31.8,
   "He walks miles to return a few cents. “Honest Abe.”"
  ],
  [
   32.1,
   35.0,
   "He teaches himself law. Lawyer at 27."
  ],
  [
   35.3,
   38.0,
   "1858: seven debates with Stephen Douglas over slavery."
  ],
  [
   38.2,
   41.0,
   "He loses. But now the whole country knows him."
  ],
  [
   41.3,
   43.8,
   "1860: elected the 16th President."
  ],
  [
   44.0,
   47.4,
   "An 11-year-old girl writes him: grow a beard. He does."
  ],
  [
   47.7,
   50.8,
   "Then the country splits in two. Civil War."
  ],
  [
   51.1,
   53.6,
   "January 1, 1863. The Emancipation Proclamation."
  ],
  [
   53.8,
   57.0,
   "After hours of handshakes, he waits for a steady hand."
  ],
  [
   57.3,
   60.0,
   "Gettysburg. The main speaker talks for 2 hours."
  ],
  [
   60.2,
   63.0,
   "Lincoln speaks for 2 minutes. 272 words."
  ],
  [
   63.3,
   66.3,
   "April 9, 1865. After four years, the war is over."
  ],
  [
   66.5,
   69.4,
   "Five days later: Ford's Theatre. 10:15 PM."
  ],
  [
   71.0,
   73.6,
   "He dies the next morning. He was 56."
  ],
  [
   73.8,
   76.2,
   "“Now he belongs to the ages.”"
  ],
  [
   76.6,
   79.6,
   "The boy from the log cabin held the country together."
  ],
  [
   79.68,
   81.8,
   "And helped free 4 million people."
  ]
 ],
