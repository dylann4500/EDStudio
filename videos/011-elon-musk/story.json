 "subs": [
  [
   4.0,
   7.3,
   "June 28, 1971: in Pretoria, South Africa, Elon Musk is born."
  ],
  [
   8.05,
   11.65,
   "At ten, he gets his first computer and teaches himself to code."
  ],
  [
   12.4,
   16.6,
   "At twelve, he sells his first video game, Blastar, to a magazine for $500."
  ],
  [
   17.45,
   21.35,
   "At seventeen, he moves to Canada on his own, with almost no money."
  ],
  [
   22.0,
   26.5,
   "He starts a PhD at Stanford, then quits after two days to build a company."
  ],
  [
   27.15,
   31.35,
   "He and his brother Kimbal sleep in the office and shower at the YMCA."
  ],
  [
   32.0,
   34.4,
   "In 1999, their startup sells for $307 million."
  ],
  [
   35.8,
   39.4,
   "His next company becomes PayPal, and eBay buys it for $1.5 billion."
  ],
  [
   40.05,
   43.65,
   "Instead of retiring, he bets his fortune on rockets and starts SpaceX."
  ],
  [
   44.5,
   47.8,
   "His first rocket explodes. So does the second, and the third."
  ],
  [
   49.05,
   53.55,
   "By 2008 he's almost broke, and Tesla, his car company, is close to going under."
  ],
  [
   54.3,
   58.2,
   "Then the fourth launch reaches orbit, and NASA signs a $1.6 billion deal."
  ],
  [
   59.45,
   62.75,
   "Tesla's Model S becomes a hit. Later comes the steel Cybertruck."
  ],
  [
   63.8,
   67.4,
   "In 2015, a rocket booster flies back from space and lands itself."
  ],
  [
   68.85,
   73.35,
   "In 2018, he launches his own red Tesla into space, with a dummy astronaut driving."
  ],
  [
   74.6,
   78.8,
   "In 2020, SpaceX becomes the first company to fly astronauts to the space station."
  ],
  [
   79.85,
   84.05,
   "In 2022, he buys Twitter for $44 billion and walks in carrying a sink."
  ],
  [
   84.9,
   86.7,
   "Then he renames it X."
  ],
  [
   89.0,
   94.1,
   "In 2024, a giant tower snatches a falling booster out of the sky with two metal arms."
  ],
  [
   95.75,
   99.05,
   "Today, more than 11,000 of his Starlink satellites circle the Earth."
  ],
  [
   100.6,
   104.2,
   "Now 55, he says the next stop is a city on Mars."
  ]
 ],
