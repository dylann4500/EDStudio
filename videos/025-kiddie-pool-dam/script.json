    },
    {
      "id": "congrats",
      "say": "Congratulations, you've built a dam. It holds back six inches of water, and a beaver is already taking notes.",
      "callouts": []
    },
    {
      "id": "float",
      "say": "Gary hops in. The creek lifts the pool, and Gary floats away like a lost flip-flop.",
