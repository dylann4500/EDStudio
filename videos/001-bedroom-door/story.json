    [
      3.9,
      6.0,
      "Night one. She checked on you eleven times."
    ],
    [
      6.4,
      9.0,
      "She stood there just to watch you breathe."
    ],
    [
      9.3,
      11.75,
      "Tired or not. Every single night."
    ],
    [
      12.6,
      15.9,
      "At six, she picked your bunny up off the floor…"
    ],
    [
      16.1,
      19.7,
      "…and tucked it back under your arm."
    ],
    [
      20.5,
      23.9,
      "At fifteen, you stopped saying goodnight."
    ],
    [
      24.2,
      27.75,
      "She kept saying it anyway."
    ],
    [
      28.7,
      32.1,
      "The night you moved out, she opened the door anyway."
    ],
    [
      32.5,
      36.7,
      "“Habit,” she told your dad."
    ],
    [
      37.5,
      41.0,
      "She kept checking a room nobody slept in."
    ],
    [
      41.3,
      44.75,
      "1,095 more nights."
    ],
    [
      45.7,
      48.5,
      "Then one December, the bed wasn’t empty."
    ],
    [
      49.0,
      53.8,
      "She tucked you in like you were three days old."
    ],
    [
      54.6,
      57.5,
      "“Goodnight, baby.”"
    ]
